[Unit]
Description=Expo Dev Server (nightout-mobile staging)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/appbrio-mobile
Environment="HOME=/var/www/appbrio-mobile"
# EXPO_TOKEN is OPTIONAL again. app.config.js now omits "owner" unless EAS_BUILD is set, so the
# dev server serves an @anonymous manifest and Expo Go opens it without a login — which is how
# testers without Expo accounts use staging. It stays here because an authenticated CLI is
# harmless, and because a token is still what you would need if "owner" were ever reinstated.
# Generate one at https://expo.dev/accounts/gkloke/settings/access-tokens if you do need it.
Environment="EXPO_TOKEN=REPLACE_ME"
Environment="REACT_NATIVE_PACKAGER_HOSTNAME=expo.appbrio.com"
Environment="REACT_NATIVE_PACKAGER_PORT=80"
Environment="EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0"
Environment="EXPO_NO_TELEMETRY=1"
Environment="CI=1"
Environment="NODE_ENV=development"
# Avoid npx/npm cache issues for www-data; use project-local Expo CLI.
ExecStart=/var/www/appbrio-mobile/node_modules/.bin/expo start --port 8081
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
